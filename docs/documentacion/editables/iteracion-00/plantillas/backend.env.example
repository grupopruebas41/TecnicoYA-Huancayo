APP_NAME=TecnicoYa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tecnicoya_iter0
DB_USERNAME=tecnicoya
# Compose inyecta DB_PASSWORD desde infrastructure/.env.docker.
DB_PASSWORD=

# Mantener file durante instalación; pasar a database tras crear sus tablas.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_COOKIE=tecnicoya_iter0_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
MAIL_MAILER=log

# reverb:install genera estas credenciales. No publicar APP_SECRET.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
