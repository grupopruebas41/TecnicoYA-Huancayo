# Copiar a .env.testing (no versionado) y completar DB_PASSWORD.
# phpunit.xml fija la conexión: mysql, 127.0.0.1:3306, usuario tecnicoya_test.
# La base la elige el slot (tests/bootstrap.php y scripts/run-e2e.mjs):
#   A → tecnicoya_testing (carpeta principal)   B → tecnicoya_b_testing (worktree de Codex)
# Ver docs/documentacion/sprints/ENTORNO-PARALELO.md.
APP_ENV=testing
APP_DEBUG=false
CACHE_STORE=array
SESSION_DRIVER=database
DB_PASSWORD=
TECNICOYA_SLOT=A

# Sprint 4 (D-70): opcional. Si faltan, scripts/run-e2e.mjs genera credenciales sintéticas de Reverb por ejecución
# y usa el puerto del slot (8081 en A, 8082 en B). Pest usa las de phpunit.xml.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
