# Copiar a .env.testing (no versionado) y completar DB_PASSWORD.
# phpunit.xml ya fija la conexión: mysql, 127.0.0.1:3306, base tecnicoya_testing, usuario tecnicoya_test.
# Ver database/testing/crear-base-pruebas.sql para crear la base y el usuario.
APP_ENV=testing
APP_DEBUG=false
CACHE_STORE=array
SESSION_DRIVER=array
DB_PASSWORD=
