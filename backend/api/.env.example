APP_NAME=TecnicoYa
APP_ENV=local
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3000
PORT=3000
LOG_CHANNEL=single
CACHE_STORE=file
SESSION_DRIVER=file
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ATTEMPTS_PER_MINUTE=10
# Motor del producto: MySQL 8.4 (DEF-12).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tecnicoya
DB_USERNAME=tecnicoya
DB_PASSWORD=

# Sprint 4 (D-70): cola, correo de sandbox y tiempo real con Reverb. Genera credenciales propias para Reverb.
QUEUE_CONNECTION=database
MAIL_MAILER=log
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tecnicoya-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
