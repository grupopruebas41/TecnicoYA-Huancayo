<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true">
  <testsuites>
    <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
    <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
  </testsuites>
  <source><include><directory>app</directory><directory>database</directory><directory>routes</directory><directory>config</directory></include></source>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
    <!-- Base MySQL exclusiva de pruebas. La contraseña va en .env.testing (no versionado).
         Ningún <env> lleva force="true": el entorno del proceso puede sobrescribirlos.
         DB_DATABASE la elige tests/bootstrap.php según TECNICOYA_SLOT (A: tecnicoya_testing,
         B: tecnicoya_b_testing). -->
    <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_HOST" value="127.0.0.1"/>
    <env name="DB_PORT" value="3306"/>
    <env name="DB_USERNAME" value="tecnicoya_test"/>
    <env name="CACHE_STORE" value="array"/>
    <!-- TC-006 recrea el gestor de sesiones: el almacén debe sobrevivir entre peticiones. -->
    <env name="SESSION_DRIVER" value="database"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <!-- Sprint 4: la cola no ejecuta nada (las pruebas corren cada job con reloj controlado); el correo de la
         sandbox queda en memoria; Reverb usa credenciales sintéticas solo para firmar /broadcasting/auth y un puerto
         cerrado, así que publicar sin Event::fake falla rápido y queda como entrega fallida del outbox. La cola y el
         broadcasting se fijan además en tests/bootstrap.php porque la CI define QUEUE_CONNECTION=sync. -->
    <env name="QUEUE_CONNECTION" value="null"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="BROADCAST_CONNECTION" value="reverb"/>
    <env name="REVERB_APP_ID" value="tecnicoya-pruebas"/>
    <env name="REVERB_APP_KEY" value="clave-sintetica-de-pruebas"/>
    <env name="REVERB_APP_SECRET" value="secreto-sintetico-de-pruebas"/>
    <env name="REVERB_HOST" value="127.0.0.1"/>
    <env name="REVERB_PORT" value="9"/>
    <env name="REVERB_SCHEME" value="http"/>
  </php>
</phpunit>
