{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend React",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend Laravel",
      "type": "shell",
      "command": "php artisan serve --host=127.0.0.1 --port=3000",
      "options": {
        "cwd": "${workspaceFolder}/backend/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Plazos automáticos",
      "type": "shell",
      "command": "php artisan schedule:work",
      "options": {
        "cwd": "${workspaceFolder}/backend/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TecnicoYa: Iniciar todo",
      "dependsOn": [
        "Frontend React",
        "Backend Laravel",
        "Plazos automáticos"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
