    "@vitest/coverage-v8": "5.0.3",
    "cypress": "^16.1.1",
    "eslint": "^10.13.0",
    "jsdom": "^25.0.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
